{
  "manifest_version": 3,
  "name": "AI Toolbox",
  "version": "0.1.0",
  "description": "AI tools for anything you read on the web.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Toolbox"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
